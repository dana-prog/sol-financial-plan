  "description": "Narrow repeated loan and borrowing lookup inputs after isolating Budget Future Expenses as a performance bottleneck.",
  "status": "Applied and verified in the performance test copy on 2026-11-20. Not applied to the original plan.",
  "scope": "Two shared financing named functions in the test copy. No Apps Script or cell formulas changed permanently. All diagnostic freezes were restored.",
  "changesSummary": [
    "Cache HEADER_ROW once within each lookup.",
    "Use CHOOSECOLS to pass only _Name or Param to COL_VALUES, avoiding extraction of every data column for each monthly lookup.",
    "Preserve function names, three existing arguments, COL_VALUES, HEADER_ROW, MONTH_START, and their financial lookup semantics."
  ],
  "namedFunctionChanges": {
    "LOAN_PARAM_VALUE_BY_LOAN": {
      "before": "=LET(names, COL_VALUES(S_LOANS, \"_Name\"), params, COL_VALUES(S_LOANS, \"Param\"), loan_row, MATCH(1, ARRAYFORMULA((names = loan_name) * (params = param_name)), 0) + 1, month_column, MATCH(MONTH_START(m), HEADER_ROW(S_LOANS), 0), INDEX(S_LOANS, loan_row, month_column))",
      "after": "=LET(headers, HEADER_ROW(S_LOANS), names, COL_VALUES(CHOOSECOLS(S_LOANS, MATCH(\"_Name\", headers, 0)), \"_Name\"), params, COL_VALUES(CHOOSECOLS(S_LOANS, MATCH(\"Param\", headers, 0)), \"Param\"), loan_row, MATCH(1, ARRAYFORMULA((names = loan_name) * (params = param_name)), 0) + 1, month_column, MATCH(MONTH_START(m), headers, 0), INDEX(S_LOANS, loan_row, month_column))"
    },
    "BORROWING_PARAM_VALUE_BY_BORROWING": {
      "before": "=LET(\n  names, COL_VALUES(S_BORROWINGS, \"_Name\"),\n  params, COL_VALUES(S_BORROWINGS, \"Param\"),\n\n  loan_row, MATCH(\n    1,\n    ARRAYFORMULA(\n      (names = loan_name) *\n      (params = param_name)\n    ),\n    0\n  ) + 1,\n\n  month_column, MATCH(\n    MONTH_START(m),\n    HEADER_ROW(S_BORROWINGS),\n    0\n  ),\n\n  INDEX(S_BORROWINGS, loan_row, month_column)\n)",
      "after": "=LET(headers, HEADER_ROW(S_BORROWINGS), names, COL_VALUES(CHOOSECOLS(S_BORROWINGS, MATCH(\"_Name\", headers, 0)), \"_Name\"), params, COL_VALUES(CHOOSECOLS(S_BORROWINGS, MATCH(\"Param\", headers, 0)), \"Param\"), loan_row, MATCH(1, ARRAYFORMULA((names = loan_name) * (params = param_name)), 0) + 1, month_column, MATCH(MONTH_START(m), headers, 0), INDEX(S_BORROWINGS, loan_row, month_column))"
    }
  },
