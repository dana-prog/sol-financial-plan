    "formula": "=LET(\n  month, B2,\n  expense_type, B1,\n  IF(expense_type = \"Setup Expenses\",  SETUP_EXPENSES_D(month),\n    IF(expense_type = \"Construction Expenses\", CONSTRUCTION_EXPENSES_D(month),\n      IF(expense_type = \"Operational Expenses\", OPERATIONAL_EXPENSES_D(month),\n        IF(expense_type = \"Land Expenses\", LAND_EXPENSES_D(month),\n          IF(\n            expense_type = \"All\",\n            LET(\n              all_expenses,\n              VSTACK(\n                CONSTRUCTION_EXPENSES_D(month),\n                LAND_EXPENSES_D(month),\n                OPERATIONAL_EXPENSES_D(month),\n                SETUP_EXPENSES_D(month),\n              ),               \n              FILTER(\n                all_expenses,\n                CHOOSECOLS(all_expenses, 1) <> \"\"\n              )\n            )\n          )\n        )\n      )\n    )\n  )\n)",
