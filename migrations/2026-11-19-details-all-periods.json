{
  "spreadsheetId": "1mxvjXTedpabDNPl-WOEie4vdpeIwCnXDlzvihZvUML4",
  "sheet": "Details",
  "description": "Prepend All Month, All Quarters and All Years to the dependent selector. Exclude source _category=Totals rows only from the All expense type, preserving existing named-function calls.",
  "before": {
    "formula": "=LET(\n  period, B1,\n  selected, B2,\n  expense_type, B3,\n  months, FILTER(R_MONTHS, ISNUMBER(R_MONTHS)),\n  labels, ARRAYFORMULA(IF(period=\"Month\", TEXT(months, \"mmm yyyy\"),\n    IF(period=\"Quarter\", \"Q\"&ROUNDUP(MONTH(months)/3)&\" \"&YEAR(months),\n      TEXT(months, \"yyyy\")))),\n  IF(SUM(ARRAYFORMULA(N(labels=TO_TEXT(selected))))=0, \"\",\n    LET(\n      selected_months, FILTER(months, labels=TO_TEXT(selected)),\n      monthly_details, LAMBDA(month, IF(expense_type = \"Setup Expenses\",  SETUP_EXPENSES_D(month),\n    IF(expense_type = \"Construction Expenses\", CONSTRUCTION_EXPENSES_D(month),\n      IF(expense_type = \"Operational Expenses\", OPERATIONAL_EXPENSES_D(month),\n        IF(expense_type = \"Land Expenses\", LAND_EXPENSES_D(month),\n          IF(\n            expense_type = \"All\",\n            LET(\n              all_expenses,\n              VSTACK(\n                CONSTRUCTION_EXPENSES_D(month),\n                LAND_EXPENSES_D(month),\n                OPERATIONAL_EXPENSES_D(month),\n                SETUP_EXPENSES_D(month),\n              ),               \n              FILTER(\n                all_expenses,\n                CHOOSECOLS(all_expenses, 1) <> \"\"\n              )\n            )\n          )\n        )\n      )\n    )\n  )),\n      IF(period=\"Month\", monthly_details(INDEX(selected_months, 1, 1)),\n        LET(\n          expenses, REDUCE({\"\",\"\",\"\",0}, selected_months,\n            LAMBDA(result, month, VSTACK(result, monthly_details(month)))),\n          IFNA(QUERY(expenses,\n            \"select Col1, Col2, Col3, sum(Col4) where Col1 is not null group by Col1, Col2, Col3 label sum(Col4) ''\", 0),\n            {\"\",\"\",\"\",0})\n        )\n      )\n    )\n  )\n)",
