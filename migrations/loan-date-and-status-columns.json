            "values": [
              {
                "userEnteredValue": {
                  "formulaValue": "=IF($C$88=\"\",\"\",IF($F$88=0,\"N/A\",EDATE($C$88,12*$G$88)))"
                },
                "note": "Loan date plus the interest-start years in column G. Payments are modeled in this date’s month, subject to available cash. N/A for interest-free loans."
              },
              {
                "userEnteredValue": {
                  "formulaValue": "=IF($C$88=\"\",\"\",EDATE($C$88,12*$H$88))"
                },
                "note": "Loan date plus full-repayment years in column H. The forecast checks repayment by the end of this month."
              },
              {
                "userEnteredValue": {
                  "formulaValue": "=IF($C$88=\"\",\"\",IF(OR(AND($F$88>0,SUMIF($N$3:$DE$3,\"<=\"&EOMONTH(EDATE($C$88,12*$G$88),0),$N$90:$DE$90)>0.01,SUMIF($N$3:$DE$3,\"<=\"&EOMONTH(EDATE($C$88,12*$G$88),0),$N$97:$DE$97)<=0.01),SUMIF($N$3:$DE$3,\"<=\"&EOMONTH(EDATE($C$88,12*$H$88),0),$N$90:$DE$90)-SUMIF($N$3:$DE$3,\"<=\"&EOMONTH(EDATE($C$88,12*$H$88),0),$N$97:$DE$97)>0.01),\"Late interest payment\",IF(SUMIF($N$3:$DE$3,\"<=\"&EOMONTH(EDATE($C$88,12*$H$88),0),$N$89:$DE$89)-SUMIF($N$3:$DE$3,\"<=\"&EOMONTH(EDATE($C$88,12*$H$88),0),$N$94:$DE$94)>0.01,\"Late principal payment\",\"On time\")))"
                },
                "note": "Forecast status checked at month-end: late interest means no interest payment by the interest-start month despite accrued interest, or interest remains at maturity. Late principal means principal remains at maturity. Interest lateness takes precedence when both are late. Recalculate loan payments after changing inputs."
              }
            ]
          }
