            "values": [
              {
                "userEnteredValue": {
                  "formulaValue": "=IF($C$4=\"\",\"\",IF($F$4=0,\"N/A\",EDATE($C$4,12*$G$4)))"
                },
                "note": "Loan date plus the interest-start years in column G. Payments are modeled in this date’s month, subject to available cash. N/A for interest-free loans."
              },
              {
                "userEnteredValue": {
                  "formulaValue": "=IF($C$4=\"\",\"\",EDATE($C$4,12*$H$4))"
                },
                "note": "Loan date plus full-repayment years in column H. The forecast checks repayment by the end of this month."
              },
              {
                "userEnteredValue": {
                  "formulaValue": "=IF($C$4=\"\",\"\",IF(OR(AND($F$4>0,SUMIF($N$3:$DE$3,\"<=\"&EOMONTH(EDATE($C$4,12*$G$4),0),$N$6:$DE$6)>0.01,SUMIF($N$3:$DE$3,\"<=\"&EOMONTH(EDATE($C$4,12*$G$4),0),$N$13:$DE$13)<=0.01),SUMIF($N$3:$DE$3,\"<=\"&EOMONTH(EDATE($C$4,12*$H$4),0),$N$6:$DE$6)-SUMIF($N$3:$DE$3,\"<=\"&EOMONTH(EDATE($C$4,12*$H$4),0),$N$13:$DE$13)>0.01),\"Late interest payment\",IF(SUMIF($N$3:$DE$3,\"<=\"&EOMONTH(EDATE($C$4,12*$H$4),0),$N$5:$DE$5)-SUMIF($N$3:$DE$3,\"<=\"&EOMONTH(EDATE($C$4,12*$H$4),0),$N$10:$DE$10)>0.01,\"Late principal payment\",\"On time\")))"
                },
                "note": "Forecast status checked at month-end: late interest means no interest payment by the interest-start month despite accrued interest, or interest remains at maturity. Late principal means principal remains at maturity. Interest lateness takes precedence when both are late. Recalculate loan payments after changing inputs."
              }
            ]
          }
        ],
        "fields": "userEnteredValue,note"
      }
